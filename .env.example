# Copie para .env.local (nunca commitar .env.local — ver .gitignore).
# Validado em src/lib/env.ts. Falta ou valor inválido = boot falha.

NODE_ENV=development
# development = dev.rzrtdigital.com/local, production = app.rzrtdigital.com.
# Diferente de NODE_ENV, que o Next.js força para "production" em qualquer
# `next build`/`next start`, inclusive no deploy de dev.
APP_ENV=development

# ---- Banco (Postgres via Prisma) -----------------------------------------
# Local: docker-compose up -d postgres
DATABASE_URL="postgresql://rzrt:rzrt@localhost:5432/rzrt_dev"
DIRECT_URL="postgresql://rzrt:rzrt@localhost:5432/rzrt_dev"

# ---- Auth.js --------------------------------------------------------------
# Gerar com: openssl rand -base64 32 — nunca usar valor default, nunca commitar.
AUTH_SECRET="troque-este-valor-por-um-gerado-com-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ---- E-mail transacional (Resend) -----------------------------------------
# Em desenvolvimento sem domínio verificado, use EMAIL_TRANSPORT=console: o
# link de convite/reset é logado no terminal, nunca enviado de fato.
EMAIL_TRANSPORT="console"
RESEND_API_KEY=""
EMAIL_FROM="RZRT Digital <nao-responda@rzrtdigital.com>"
# Fora de produção, e-mail só sai de fato para estes domínios (CLAUDE.md §4.12).
EMAIL_DEV_ALLOWLIST_DOMAINS="rzrtdigital.com,demo.rzrtdigital.com"

# ---- Rate limit (Upstash Redis) -------------------------------------------
UPSTASH_REDIS_REST_URL="https://exemplo.upstash.io"
UPSTASH_REDIS_REST_TOKEN="troque-este-valor"

# ---- Storage (S3-compatible / Cloudflare R2) -------------------------------
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_BUCKET="rzrt-files-dev"
S3_ACCESS_KEY_ID="troque-este-valor"
S3_SECRET_ACCESS_KEY="troque-este-valor"
S3_PUBLIC_URL="https://files-dev.rzrtdigital.com"

# ---- App --------------------------------------------------------------
APP_URL="http://localhost:3000"

# ---- Observabilidade --------------------------------------------------
SENTRY_DSN=""
