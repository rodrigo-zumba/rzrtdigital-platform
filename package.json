{
  "name": "rzrt-digital-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/prisma-generate-if-schema.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "node scripts/guard-not-production.mjs \"prisma migrate dev\" && prisma migrate dev",
    "prisma:migrate:reset": "node scripts/guard-not-production.mjs \"prisma migrate reset\" && prisma migrate reset",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node scripts/guard-not-production.mjs \"prisma db seed\" && tsx prisma/seed.ts",
    "create-superadmin": "tsx scripts/create-superadmin.ts",
    "predeploy": "node scripts/guard-production.mjs",
    "deploy": "npm run prisma:migrate:deploy"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "7.9.1",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.2",
    "clsx": "^2.1.1",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
}
